# KaryaLaya 2.0 — Environment Variables Configuration
# Copy this file to .env.local for local development

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"

# PostgreSQL Database (Phase 1)
DATABASE_URL="postgresql://karyalaya:password@localhost:5432/karyalaya_db?schema=public"

# NextAuth / Authentication (Phase 1)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="karyalaya_super_secret_development_key_change_in_production"

# AI Integration Layer (Phase 3)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Cloud Storage / Deliverable Assets (Phase 2)
S3_BUCKET_NAME=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
